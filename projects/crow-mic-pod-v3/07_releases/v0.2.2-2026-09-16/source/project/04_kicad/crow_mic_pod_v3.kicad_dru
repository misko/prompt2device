(version 1)
(rule "POD_INPUT_width"
  (condition "A.NetClass == 'POD_INPUT'")
  (constraint track_width (min 0.5mm)))
(rule "QUIET_POWER_width"
  (condition "A.NetClass == 'QUIET_POWER'")
  (constraint track_width (min 0.4mm)))
(rule "BALANCED_AUDIO_width"
  (condition "A.NetClass == 'BALANCED_AUDIO'")
  (constraint track_width (min 0.25mm)))
(rule "QUIET_ANALOG_width"
  (condition "A.NetClass == 'QUIET_ANALOG'")
  (constraint track_width (min 0.25mm)))
(rule pad_rescue_stubs
  (condition "A.insideArea('pad_rescue_stubs') && (A.NetName == 'GND')")
  (constraint track_width (min 0.300mm)))
