+def _condition_matches(cond, a, b, areas):
+    """Evaluate the intentionally small, supported DRU condition language.
+
+    KiCad's boolean operators have equal precedence.  Parse that explicitly
+    (left-to-right inside each parenthesised group) rather than using Python's
+    different ``and``/``or`` precedence.
+    """
+    items = {"A": a, "B": b}
+    tokens, pos = [], 0
+    while pos < len(cond):
+        if cond[pos].isspace():
+            pos += 1
+            continue
+        if cond.startswith("&&", pos) or cond.startswith("||", pos):
+            tokens.append(cond[pos:pos + 2]); pos += 2; continue
+        if cond[pos] in "()":
+            tokens.append(cond[pos]); pos += 1; continue
+        m = _ATOM_RE.match(cond, pos)
+        if not m:
+            return False
+        side, field, value, area_side, area = m.groups()
+        if side:
+            item = items[side]
+            key = {"NetClass": "cls", "NetName": "net", "Type": "type"}[field]
+            tokens.append(item.get(key, "Pad" if key == "type" else "") == value)
+        else:
+            tokens.append(_item_in_area(items[area_side], area, areas))
+        pos = m.end()
+    def primary(i):
+        if i >= len(tokens):
+            raise ValueError
+        if tokens[i] == "(":
+            value, i = group(i + 1)
+            if i >= len(tokens) or tokens[i] != ")":
+                raise ValueError
+            i += 1
+        elif isinstance(tokens[i], bool):
+            value, i = tokens[i], i + 1
+        else:
+            raise ValueError
+        return value, i
+    def group(i):
+        value, i = primary(i)
+        while i < len(tokens) and tokens[i] != ")":
+            op = tokens[i]
+            if op not in ("&&", "||"):
+                raise ValueError
+            rhs, i = primary(i + 1)
+            value = value and rhs if op == "&&" else value or rhs
+        return value, i
+    try:
+        value, end = group(0)
+        return end == len(tokens) and value
+    except ValueError:
+        return False
+
+
+def _item_in_area(item, name, areas):
+    for poly, layers in areas.get(name, []):
+        if not (layers & item["layers"]):
+            continue
+        shape = item.get("poly")
+        if shape and _polys_intersect(shape, poly):
+            return True
+        seg = item.get("seg")
+        if seg and (_point_in_poly(seg[0], poly) or _point_in_poly(seg[1], poly)
+                    or _poly_seg_dist(poly, *seg) <= item.get("width", 0.0) / 2.0):
+            return True
+    return False
+
+
+def _polys_intersect(a, b):
