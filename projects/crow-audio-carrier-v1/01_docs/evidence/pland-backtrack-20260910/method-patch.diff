+@test("P-LAND resolves pair-scoped clearance in either A/B order without "
+      "leaking pad-only rules to a track", kind="known_bad", gate="escape_check.py")
+def t_land_pair_scoped_clearance_is_pair_and_type_specific():
+    """The crow carrier's ADC_RESET_PITCH rule is a real B-side match: the
+    ADC launch is A and the adjacent reset pad is B.  The former reader only
+    considered A, then applied the largest nearby netclass clearance to every
+    obstacle, turning an unrelated remote 0.25 mm class into a false failure.
+
+    This is intentionally a small geometry fixture: it proves condition
+    semantics without making the checked board or generated source an input.
+    The same rule must also match in reversed order, require BOTH items in its
+    area, honour last-match precedence, and leave a Pad/Pad exception unable
+    to relax a Track/Pad pair.
+    """
+    sys.path.insert(0, str(SCRIPTS))
+    import escape_check as ec
+    rules = ec.read_dru_rules_from_text("""
+(rule "remote_class"
+  (condition "A.NetClass == 'HI'")
+  (constraint clearance (min 0.25mm)))
+(rule "reset_pair"
+  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.insideArea('PITCH') && B.insideArea('PITCH') && (A.NetName == 'RESET' || B.NetName == 'RESET')")
+  (constraint clearance (min 0.20mm)))
+(rule "last_pair"
+  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.insideArea('PITCH') && B.insideArea('PITCH') && (A.NetName == 'RESET' || B.NetName == 'RESET')")
+  (constraint clearance (min 0.18mm)))
+""")
+    square = [(0, 0), (2, 0), (2, 2), (0, 2)]
+    areas = {"PITCH": [(square, frozenset({0}))]}
+    def item(net, cls, xy, typ="Pad"):
+        x, y = xy
+        return {"net": net, "cls": cls, "type": typ, "layers": frozenset({0}),
+                "c": xy, "poly": [(x-.05,y-.05),(x+.05,y-.05),
+                                  (x+.05,y+.05),(x-.05,y+.05)]}
+    adc, reset = item("ADC", "LO", (0.5, 0.5)), item("RESET", "HI", (1, 0.5))
+    eq(ec.resolve_pair_min(rules, "clearance", adc, reset, areas),
+       (0.18, "last_pair"), "B-side reset match and last rule win")
+    eq(ec.resolve_pair_min(rules, "clearance", reset, adc, areas),
+       (0.18, "last_pair"), "reversed A/B order")
+    outside = item("RESET", "HI", (3, 0.5))
+    eq(ec.resolve_pair_min(rules, "clearance", adc, outside, areas),
+       (0.25, "remote_class"), "a remote high-class pair keeps its own rule")
+    track = item("RESET", "HI", (1, 0.5), "Track")
+    eq(ec.resolve_pair_min(rules, "clearance", adc, track, areas),
+       (0.25, "remote_class"), "Pad/Pad exception does not relax Track/Pad")
+    contained = {"net": "ADC", "cls": "LO", "type": "Track",
+                 "layers": frozenset({0}), "seg": ((.4, .4), (.6, .4)), "width": .20}
