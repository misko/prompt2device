+def resolve_pair_min(rules, constraint, a, b, areas):
+    """KiCad pair-rule resolution, including both A/B orderings.
+
+    A local relaxation applies only when its complete condition holds for the
+    candidate and this exact obstacle.  In particular, Pad/Pad rules cannot
+    turn into Track/Pad permissions and an area predicate applies to each
+    item named by the rule.
+    """
+    hit = (None, None)
+    for r in rules:
+        if r["constraint"] != constraint or r["kind"] == "unparsed":
+            continue
+        if (_condition_matches(r["cond"], a, b, areas)
+                or _condition_matches(r["cond"], b, a, areas)):
+            hit = (r["min_mm"], r["name"])
+    return hit
+
