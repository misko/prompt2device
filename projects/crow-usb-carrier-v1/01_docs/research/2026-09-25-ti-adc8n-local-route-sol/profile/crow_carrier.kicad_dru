(version 1)
(rule "USB_HS_width"
  (condition "A.NetClass == 'USB_HS'")
  (constraint track_width (min 0.41mm)))
(rule "USB_HS_diffpair"
  (condition "A.NetClass == 'USB_HS'")
  (constraint diff_pair_gap (min 0.145mm) (opt 0.15mm)))
(rule "INPUT_TRUNK_width"
  (condition "A.NetClass == 'INPUT_TRUNK'")
  (constraint track_width (min 1.2mm)))
(rule "PARENT_5V_width"
  (condition "A.NetClass == 'PARENT_5V'")
  (constraint track_width (min 1.0mm)))
(rule "DIGITAL_POWER_width"
  (condition "A.NetClass == 'DIGITAL_POWER'")
  (constraint track_width (min 0.6mm)))
(rule "POD_POWER_width"
  (condition "A.NetClass == 'POD_POWER'")
  (constraint track_width (min 0.5mm)))
(rule "QUIET_POWER_width"
  (condition "A.NetClass == 'QUIET_POWER'")
  (constraint track_width (min 0.5mm)))
