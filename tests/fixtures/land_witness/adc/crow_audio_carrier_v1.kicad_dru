(version 1)
(rule "POD_POWER_width"
  (condition "A.NetClass == 'POD_POWER'")
  (constraint track_width (min 0.6mm)))
(rule "POWER_TRANSIENT_width"
  (condition "A.NetClass == 'POWER_TRANSIENT'")
  (constraint track_width (min 1.2mm)))
(rule "POWER_CONTROL_width"
  (condition "A.NetClass == 'POWER_CONTROL'")
  (constraint track_width (min 0.2mm)))
(rule "BOOTSTRAP_width"
  (condition "A.NetClass == 'BOOTSTRAP'")
  (constraint track_width (min 0.2mm)))
