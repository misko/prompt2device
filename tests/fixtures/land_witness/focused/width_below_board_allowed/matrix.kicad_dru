(version 1)
(rule "empty_baseline" (condition "") (constraint track_width (min 0.2mm)))
(rule "b_side_pairbase" (condition "A.NetName == 'b_side_T'") (constraint clearance (min 0.25mm)))
(rule "b_side_relax" (condition "B.NetName == 'b_side_B'") (constraint clearance (min 0.2mm)))
(rule "reversal_pairbase" (condition "A.NetName == 'reversal_T'") (constraint clearance (min 0.25mm)))
(rule "reversal_relax" (condition "A.NetName == 'reversal_B' && B.Type == 'Track'") (constraint clearance (min 0.2mm)))
(rule "both_area_pairbase" (condition "A.NetName == 'both_area_T'") (constraint clearance (min 0.25mm)))
(rule "both_area_relax" (condition "A.insideArea('both_area_AREA') && B.insideArea('both_area_AREA') && (A.NetName == 'both_area_T')") (constraint clearance (min 0.2mm)))
(rule "offcenter_pairbase" (condition "A.NetName == 'offcenter_T'") (constraint clearance (min 0.2mm)))
(rule "offcenter_wide" (condition "A.NetName == 'offcenter_T'") (constraint track_width (min 0.4mm)))
(rule "offcenter_local" (condition "A.insideArea('offcenter_AREA') && (A.NetName == 'offcenter_T')") (constraint track_width (min 0.2mm)))
(rule "contained_pairbase" (condition "A.NetName == 'contained_T'") (constraint clearance (min 0.2mm)))
(rule "contained_wide" (condition "A.NetName == 'contained_T'") (constraint track_width (min 0.4mm)))
(rule "contained_local" (condition "A.insideArea('contained_AREA') && (A.NetName == 'contained_T')") (constraint track_width (min 0.2mm)))
(rule "padpad_guard_pairbase" (condition "A.NetName == 'padpad_guard_T'") (constraint clearance (min 0.25mm)))
(rule "padpad_guard_relax" (condition "A.Type == 'Pad' && B.Type == 'Pad' && (A.NetName == 'padpad_guard_T')") (constraint clearance (min 0.15mm)))
(rule "track_width_pairbase" (condition "A.NetName == 'track_width_T'") (constraint clearance (min 0.2mm)))
(rule "track_width_width" (condition "A.Type == 'Track' && (A.NetName == 'track_width_T')") (constraint track_width (min 0.2mm)))
(rule "area_layer_pairbase" (condition "A.NetName == 'area_layer_T'") (constraint clearance (min 0.2mm)))
(rule "area_layer_width" (condition "A.insideArea('area_layer_AREA') && (A.NetName == 'area_layer_T')") (constraint track_width (min 0.3mm)))
(rule "last_match_pairbase" (condition "A.NetName == 'last_match_T'") (constraint clearance (min 0.2mm)))
(rule "last_match_width_0.4" (condition "A.Type == 'Track' && (A.NetName == 'last_match_T')") (constraint track_width (min 0.4mm)))
(rule "last_match_width_0.2" (condition "A.Type == 'Track' && (A.NetName == 'last_match_T')") (constraint track_width (min 0.2mm)))
(rule "boolean_left_pairbase" (condition "A.NetName == 'boolean_left_T'") (constraint clearance (min 0.2mm)))
(rule "boolean_left_width" (condition "A.NetName == 'boolean_left_T' || A.NetName == 'NEVER' && A.Type == 'Pad'") (constraint track_width (min 0.4mm)))
(rule "negation_pairbase" (condition "A.NetName == 'negation_T'") (constraint clearance (min 0.2mm)))
(rule "negation_wide" (condition "A.NetName == 'negation_T'") (constraint track_width (min 0.4mm)))
(rule "negation_local" (condition "!(A.NetName != 'negation_T')") (constraint track_width (min 0.2mm)))
(rule "wildcard_pairbase" (condition "A.NetName == 'wildcard_T'") (constraint clearance (min 0.2mm)))
(rule "wildcard_wide" (condition "A.NetName == 'wildcard_T'") (constraint track_width (min 0.4mm)))
(rule "wildcard_local" (condition "A.NetName == 'wildcard_*'") (constraint track_width (min 0.2mm)))
(rule "multi_constraint_pairbase" (condition "A.NetName == 'multi_constraint_T'") (constraint clearance (min 0.2mm)))
(rule "multi_constraint_both" (condition "A.NetName == 'multi_constraint_T'") (constraint clearance (min 0.2mm)) (constraint track_width (min 0.2mm)))
(rule "rule_layer_pairbase" (condition "A.NetName == 'rule_layer_T'") (constraint clearance (min 0.2mm)))
(rule "rule_layer_width" (layer "F.Cu") (condition "A.Type == 'Track' && (A.NetName == 'rule_layer_T')") (constraint track_width (min 0.4mm)))
(rule "width_transition_pairbase" (condition "A.NetName == 'width_transition_T'") (constraint clearance (min 0.2mm)))
(rule "width_transition_wide" (condition "A.NetName == 'width_transition_T'") (constraint track_width (min 0.6mm)))
(rule "width_transition_local" (condition "A.insideArea('width_transition_AREA') && (A.NetName == 'width_transition_T')") (constraint track_width (min 0.2mm)))
(rule "oscillation_pairbase" (condition "A.NetName == 'oscillation_T'") (constraint clearance (min 0.1mm)))
(rule "oscillation_inside" (condition "A.Type == 'Track' && A.insideArea('oscillation_AREA') && (A.NetName == 'oscillation_T')") (constraint clearance (min 0.3mm)))
(rule "one_sided_pairbase" (condition "A.NetName == 'one_sided_T'") (constraint clearance (min 0.2mm)))
(rule "one_sided_custom" (condition "A.NetName == 'one_sided_T'") (constraint clearance (min 0.25mm)))

(rule low (condition "A.NetName == 'remote_high_T'") (constraint track_width (min 0.05mm)))
